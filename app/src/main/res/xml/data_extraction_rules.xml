<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- No credentials, settings, tracking snapshot or private feed cache. -->
        <exclude domain="file" path="datastore/" />
        <exclude domain="device_file" path="datastore/" />
        <exclude domain="database" path="." />
        <exclude domain="device_database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Apply the same policy even when a device transfer does not use cloud backup. -->
        <exclude domain="file" path="datastore/" />
        <exclude domain="device_file" path="datastore/" />
        <exclude domain="database" path="." />
        <exclude domain="device_database" path="." />
    </device-transfer>
</data-extraction-rules>
